{{- $platform := includeTemplate "platform" . | trim -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

{{ if eq .purpose "personal" -}}
{{ onepasswordRead "op://42pk3tvtm6fxtqjngclmmsrsia/lwxztnwep6ahoelyqf5dfgn4qq/config" }}
{{ end -}}
# GitHub distinguishes accounts by key, not username, so all accounts collapse to
# one multiplex socket (master-git@github.com:22). Disable sharing so per-repo key
# pins (core.sshCommand) are always honored on a fresh connection.
Host github.com
  ControlMaster no
  ControlPath none
  IdentityAgent none

Host *
{{ if eq $platform "macos" }}  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ else if eq $platform "windows" }}  IdentityAgent \\.\pipe\openssh-ssh-agent
{{ else if eq $platform "wsl" }}  IdentityAgent ~/.1password/agent.sock
{{ end }}  ControlMaster auto
  ControlPath ~/.ssh/master-%r@%h:%p
  ControlPersist 10m
