# PowerShell profile (Windows-native). Managed by chezmoi — edit the source in
# the dotfiles repo, not this file. There is no zsh on Windows native; this
# mirrors the high-value bits of dot_zshrc.tmpl.

# --- Claude ---
if (Get-Command claude -ErrorAction SilentlyContinue) {
  function c { claude --permission-mode auto @args }
}

# --- Git helpers (parity with the zsh aliases) ---
function gdours   { git diff REBASE_HEAD~ HEAD @args }
function gdthiers { git diff REBASE_HEAD~ REBASE_HEAD @args }

# --- PATH: user-local bin ---
$localBin = Join-Path $HOME ".local\bin"
if ((Test-Path $localBin) -and ($env:PATH -notlike "*$localBin*")) {
  $env:PATH = "$localBin;$env:PATH"
}

